{
  "name": "@capstone/db",
  "version": "0.1.0",
  "private": true,
  "description": "PostgreSQL schema migrations, the application query catalogue, and the AP deliverable generator.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "migrate": "node --env-file-if-exists=../.env scripts/migrate.js up",
    "migrate:status": "node --env-file-if-exists=../.env scripts/migrate.js status",
    "ap:build": "node scripts/build-ap.js",
    "ap:check": "node scripts/build-ap.js --check && node scripts/check-ap-deliverables.js",
    "test": "node --env-file-if-exists=../.env --test --test-concurrency=1",
    "ap:diagram": "node scripts/render-diagram.js",
    "benchmark": "node --env-file-if-exists=../.env scripts/benchmark.js"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
