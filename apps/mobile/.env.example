# Copy to apps/mobile/.env  (git-ignored). Expo reads .env from the app folder, not the repo root.
# EXPO_PUBLIC_* values are compiled into the app and are public. Never put secrets here.

# The API the phone talks to. A phone cannot reach "localhost" on your computer: use your
# computer's LAN IP address, with phone and computer on the same network.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# DEVELOPMENT ONLY. Allows enrolling an Android device whose Keystore reports security level
# "software" (e.g. an emulator). Ignored in release builds (__DEV__ is false). The server records
# such keys as key_storage = "software" and the app shows a warning. Leave unset on real phones.
# EXPO_PUBLIC_ALLOW_SOFTWARE_KEYS=true
