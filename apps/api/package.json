{
  "name": "@capstone/api",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js API: accounts, device enrollment, QR login challenges, sessions, real-time approval.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.js",
    "start": "node --env-file-if-exists=../../.env src/server.js",
    "test": "node --env-file-if-exists=../../.env --test --test-concurrency=1 test/*.test.js",
    "create-dev-user": "node --env-file-if-exists=../../.env scripts/create-dev-user.js",
    "smoke": "node --env-file-if-exists=../../.env scripts/smoke-test.js"
  },
  "dependencies": {
    "@capstone/db": "*",
    "@capstone/protocol": "*",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
