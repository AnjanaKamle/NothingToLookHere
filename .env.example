# Copy to .env and fill in values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.
# Variables marked (required) have no default. Everything else shows its default value.

# --- Local PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=capstone
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=capstone
POSTGRES_PORT=5433

# --- API (apps/api) ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
# (required) Must match the POSTGRES_* values above for local development.
DATABASE_URL=postgres://capstone:change-me-local-only@localhost:5433/capstone
TEST_DATABASE_URL=postgres://capstone:change-me-local-only@localhost:5433/capstone_test
# Comma-separated browser origins. Used for the CSRF Origin check, Socket.IO CORS and
# WebSocket origin check.
WEB_ORIGIN=http://localhost:5173
# Which proxies may set X-Forwarded-For: a hop count (e.g. 1) or addresses/presets.
TRUST_PROXY=loopback
# Secure flag on cookies. Forced to true (and cannot be disabled) when NODE_ENV=production.
COOKIE_SECURE=false

# (required) HMAC key for Socket.IO watch tokens, at least 32 random bytes in base64url:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
WATCH_TOKEN_SECRET=
# Audience string included in every message the phone signs, so a signature for one deployment
# cannot be replayed against another. Use a distinct value per environment.
AUTH_AUDIENCE=capstone-local

# Lifetimes, in seconds.
LOGIN_CHALLENGE_TTL_SECONDS=60
# How long after phone approval the browser may still exchange it for a session.
LOGIN_COMPLETION_WINDOW_SECONDS=60
ENROLLMENT_CHALLENGE_TTL_SECONDS=300
SESSION_TTL_SECONDS=43200
SESSION_IDLE_TIMEOUT_SECONDS=7200

# Background cleanup (seconds). Correctness does not depend on it.
MAINTENANCE_INTERVAL_SECONDS=3600
CHALLENGE_RETENTION_SECONDS=86400
SESSION_RETENTION_SECONDS=2592000
AUDIT_RETENTION_SECONDS=31536000

# --- Web client (apps/web) ---
# No variables needed: the Vite dev server proxies /api and /socket.io to http://localhost:API_PORT.
# Only VITE_* variables would ever be exposed to browser code; never put secrets in them.

# --- Mobile app (apps/mobile) ---
# Expo reads its own file: copy apps/mobile/.env.example to apps/mobile/.env.
