# Copy this file to .env and fill in your own values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.

# PostgreSQL connection: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/sem3_capstone?schema=public"

# Secret used to sign JWTs. At least 32 random characters. Generate one with:
#   openssl rand -hex 32
JWT_SECRET="replace-this-with-a-long-random-local-secret"

PORT=3000

# "production" adds the Secure flag to cookies (HTTPS only).
NODE_ENV=development
