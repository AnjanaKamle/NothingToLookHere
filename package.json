{
  "name": "sem3-capstone",
  "version": "0.1.0",
  "private": true,
  "description": "Certificate-backed QR handoff authentication: sign in to a browser by approving with a trusted phone.",
  "workspaces": [
    "apps/*",
    "packages/*",
    "db"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "npm run migrate --workspace @capstone/db",
    "db:migrate:status": "npm run migrate:status --workspace @capstone/db",
    "db:psql": "docker compose exec postgres psql -U capstone -d capstone",
    "db:ap:build": "npm run ap:build --workspace @capstone/db",
    "db:ap:check": "npm run ap:check --workspace @capstone/db",
    "db:ap:diagram": "npm run ap:diagram --workspace @capstone/db",
    "db:benchmark": "npm run benchmark --workspace @capstone/db",
    "dev:api": "npm run dev --workspace @capstone/api",
    "dev:web": "npm run dev --workspace @capstone/web",
    "dev:mobile": "npm run start --workspace @capstone/mobile",
    "dev:create-user": "npm run create-dev-user --workspace @capstone/api --",
    "build:web": "npm run build --workspace @capstone/web",
    "test": "npm run test --workspaces --if-present",
    "smoke": "npm run smoke --workspace @capstone/api",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
