erDiagram
    USERS {
        UUID id PK
        VARCHAR phone UK
        TEXT password_hash
        TIMESTAMPTZ created_at
    }
    DEVICES {
        UUID id PK
        UUID user_id FK
        VARCHAR name
        TIMESTAMPTZ created_at
        TIMESTAMPTZ revoked_at
    }
    LOGIN_REQUESTS {
        UUID id PK
        VARCHAR token_hash UK
        VARCHAR browser_hash
        VARCHAR browser_name
        login_request_status status
        TIMESTAMPTZ created_at
        TIMESTAMPTZ expires_at
        TIMESTAMPTZ approved_at
        UUID approved_by_user_id FK
        UUID approved_by_device_id FK
    }
    SESSIONS {
        UUID id PK
        UUID user_id FK
        UUID device_id FK
        UUID login_request_id FK_UK
        session_type type
        VARCHAR name
        TIMESTAMPTZ created_at
        TIMESTAMPTZ expires_at
        TIMESTAMPTZ revoked_at
    }
    RECOVERY_CODES {
        UUID id PK
        UUID user_id FK
        VARCHAR code_hash UK
        TIMESTAMPTZ created_at
        TIMESTAMPTZ used_at
    }
    USERS ||--o{ DEVICES : registers
    USERS ||--o{ SESSIONS : owns
    USERS o|--o{ LOGIN_REQUESTS : approves
    DEVICES o|--o{ LOGIN_REQUESTS : approves
    DEVICES o|--o{ SESSIONS : identifies
    LOGIN_REQUESTS ||--o| SESSIONS : creates
    USERS ||--o{ RECOVERY_CODES : owns
